<brls:Box
  width="auto"
  height="auto"
  axis="column"
  alignItems="center"
  justifyContent="center"
  paddingLeft="50px"
  paddingRight="50px"
  paddingTop="30px"
  paddingBottom="30px">

  <brls:NoteCell
    id="top-note"
    width="100%"
    title="No game folders found. Folders should be organized like this:"
    note="SD:/mod-alchemy/[title-id-of-the-game]/[group]/[thing-being-replaced]/[mod-name]/[mod-files-and-folders]"
  />

  <brls:NoteCell
    id="bottom-note"
    width="100%"
    title="After mods are set up, see the Help Tab for how to make a proper backup."
  />

  <brls:Box
    width="100%"
    height="20px"
    marginTop="30px"
    lineTop="2px"
    lineColor="#D0D0D0"
  />

</brls:Box>
