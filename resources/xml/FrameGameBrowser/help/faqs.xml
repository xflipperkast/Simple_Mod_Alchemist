<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Header
        width="100%"
        title="A game is missing from the list."
        marginTop="20px"
        marginBottom="50px"
    />

    <brls:Label
        width="100%"
        text="Create `switch/Simple_Mod_alchemist/mods/<title_id>/` for that game."
        marginBottom="30px"
    />

    <brls:Box
        width="100%"
        height="50px"
        marginBottom="30px"
        lineBottom="2px"
        lineColor="#D0D0D0"
    />

    <brls:Header
        width="100%"
        title="A mod is enabled but nothing changes."
        marginBottom="50px"
    />

    <brls:Label
        width="100%"
        text="Check for a conflicting file in `/atmosphere/contents/<title_id>/` or a missing `romfs` / `exefs` folder."
        marginBottom="30px"
    />

    <brls:Box
        width="100%"
        height="50px"
        marginBottom="30px"
        lineBottom="2px"
        lineColor="#D0D0D0"
    />

    <brls:Header
        width="100%"
        title="A mod only applies partly."
        marginBottom="50px"
    />

    <brls:Label
        width="100%"
        text="Another mod or manual file is already using the same path. Disable the conflicting mod first."
        marginBottom="30px"
    />

    <brls:Box
        width="100%"
        height="50px"
        marginBottom="30px"
        lineBottom="2px"
        lineColor="#D0D0D0"
    />

    <brls:Header
        width="100%"
        title="The app freezes for a while."
        marginBottom="50px"
    />

    <brls:Label
        width="100%"
        text="Large mods with many files can take a while. Let it finish."
        marginBottom="30px"
    />

    <brls:Box
        width="100%"
        height="50px"
        marginBottom="30px"
        lineBottom="2px"
        lineColor="#D0D0D0"
    />

    <brls:Header
        width="100%"
        title="The app errored or crashed."
        marginBottom="50px"
    />

    <brls:Label
        width="100%"
        text="Disable all mods, then restore from backup if you have one."
        marginBottom="30px"
    />

    <brls:Box
        width="100%"
        height="50px"
        marginBottom="30px"
        lineBottom="2px"
        lineColor="#D0D0D0"
    />

    <brls:Header
        width="100%"
        title="I want to remove the app."
        marginBottom="50px"
    />

    <brls:Label
        width="100%"
        text="Disable all mods first, then delete `switch/Simple_Mod_alchemist/mods/` and the app file from the `switch` folder."
        marginBottom="20px"
    />

</brls:Box>
