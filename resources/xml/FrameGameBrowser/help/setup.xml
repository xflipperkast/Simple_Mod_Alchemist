<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Label
        width="100%"
        text="Installing Mods"
        fontSize="30"
        horizontalAlign="center"
        marginTop="20px"
        marginBottom="100px"
    />

    <brls:Label
        width="100%"
        text="1. Create `switch/Simple_Mod_alchemist/mods/<title_id>/` for the game you want to manage."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="2. Put each mod in its own folder directly inside that game folder."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="3. Put the mod files in `romfs` and/or `exefs` folders under that mod folder."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="4. Add `[PACK]_` to the front of a folder name if it is a modpack."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="5. Launch the app, select the game, and use the Mods or Modpacks tab."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="6. If a mod does not apply, another file is already using the same path in `/atmosphere/contents/<title_id>/`."
        marginBottom="20px"
    />

</brls:Box>
