<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Label
        width="100%"
        text="Quick Start"
        fontSize="30"
        horizontalAlign="center"
        marginTop="20px"
        marginBottom="80px"
    />

    <brls:Label
        width="100%"
        text="1. Create `switch/Simple_Mod_alchemist/mods/<title_id>/` on your SD card for each game."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="2. Put each single mod in its own folder inside that game folder."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="3. Put `romfs` and/or `exefs` inside each mod folder."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="4. Prefix a folder with `[PACK]_` if you want it treated as a modpack."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="5. Launch the app, select the game, and use the Mods and Modpacks tabs."
        marginBottom="40px"
    />

    <brls:Label
        width="100%"
        text="6. Use `Disable all mods` before moving files by hand."
        marginBottom="20px"
    />

</brls:Box>
