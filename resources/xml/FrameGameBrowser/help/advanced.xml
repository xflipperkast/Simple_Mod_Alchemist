<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Label
        width="100%"
        text="Manual Mods"
        fontSize="30"
        horizontalAlign="center"
        marginTop="20px"
        marginBottom="100px"
    />

    <brls:Label
        width="100%"
        text="You can still edit the mod folders by hand, but use `Disable all mods` first so the app starts from a clean state."
        marginBottom="30px"
    />

    <brls:Label
        width="100%"
        text="Enabled files live in `/atmosphere/contents/<title_id>/` and should move back into the mod folder when disabled."
        marginBottom="30px"
    />

    <brls:Label
        width="100%"
        text="If a mod only partly applies, another mod or manual file is already occupying the same path."
        marginBottom="30px"
    />

    <brls:Label
        width="100%"
        text="If the app gets out of sync, disable all mods and reopen it before changing anything else."
        marginBottom="20px"
    />

</brls:Box>
