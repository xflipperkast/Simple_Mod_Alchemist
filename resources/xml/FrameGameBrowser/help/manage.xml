<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <brls:Header
        width="100%"
        title="Adding Mods"
        marginTop="20px"
        marginBottom="50px"
    />

    <brls:Label
        width="100%"
        text="See `Setup`."
    />

    <brls:Box
        width="100%"
        height="50px"
        marginBottom="30px"
        lineBottom="2px"
        lineColor="#D0D0D0"
    />

    <brls:Header
        width="100%"
        title="Deleting Mods"
        marginBottom="50px"
    />

    <brls:Label
        width="100%"
        text="Disable the mod first, then delete its folder from `switch/Simple_Mod_alchemist/mods/<title_id>/`."
        marginBottom="30px"
    />

    <brls:Label
        width="100%"
        text="If a mod is active, its files are in `/atmosphere/contents/<title_id>/`, so disabling it first puts them back."
        marginBottom="30px"
    />

    <brls:Label
        width="100%"
        text="Keep the `romfs` and `exefs` structure intact when you move or rename folders."
    />

</brls:Box>
